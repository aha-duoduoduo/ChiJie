node_pools:
    # 模板池示例：按地区动态生成账号
    provider-example:
        source: template
        enabled: true
        type: http_proxy
        server: proxy.provider.example
        port: 443
        username_template: account-region-{region}
        password: REPLACE_WITH_YOUR_PASSWORD

    # 直连池
    direct:
        source: direct

    # 静态节点池示例
    static-example:
        source: static
        nodes:
            - name: hk-socks5-1
              type: socks5
              server: example.com
              port: 1080
              region: HK
              # 高端节点用于对出口质量要求更高的目标站点。
              premium: false
              username: REPLACE_WITH_USERNAME
              password: REPLACE_WITH_PASSWORD

    # 订阅池示例
    subscription-example:
        source: subscription
        url: https://your-subscription-host/path?token=REPLACE_WITH_TOKEN
        # 允许直接填写本地 IP，或使用解析到私网/回环地址的域名。仅对可信订阅源开启。
        allow_private_host: false
        # 留空表示手动刷新；也支持 12h、3d 这类小时/天配置。
        update_interval: 1h
        # 设置为 true 后，该订阅池下节点默认都是高端节点。
        premium: false
        # 当某地区只有这个订阅池的一个离线节点时，仍允许请求再尝试一次。
        try_offline: false
        reject_regex:
            - 剩余流量|套餐
